<Window x:Class="AionSpeedrunOverlay.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/aion-penguin.ico"
        Title="Overlay appearance" Width="460" Height="710"
        MinWidth="420" MinHeight="400" ResizeMode="CanResize"
        WindowStyle="None" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#101722" Foreground="#E2E8F0" FontFamily="Segoe UI"
        Topmost="True">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/EditorTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Border BorderBrush="#2A3A50" BorderThickness="1" Background="#101722" CornerRadius="10">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#141F30" BorderBrush="#25344B" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
            <Grid Margin="20,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#8BB7FF" Margin="0,0,10,0"/>
                    <TextBlock Text="AION ROUTE" Foreground="#DFE9F9" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text=" / SETTINGS" Foreground="#8195B1" FontSize="11" Margin="9,0,0,0"/>
                </StackPanel>
                <Button x:Name="CaptionCloseButton" Content="&#x00D7;" Style="{StaticResource CaptionClose}" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Done_Click"/>
            </Grid>
        </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image x:Name="AppLogo" Width="86" Height="86"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="AION Overlay penguin logo"><Image.Source><BitmapImage UriSource="Assets/aion-penguin.png" DecodePixelWidth="172"/></Image.Source></Image>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="AION Overlay" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Make it yours" Foreground="#94A3B8" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Preview changes directly on your overlay."
                       Foreground="#94A3B8" Margin="0,5,0,22"/>
            <StackPanel x:Name="FactionPanel" Visibility="Collapsed" Margin="0,0,0,22">
                <TextBlock Text="QUEST FACTION" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.55*"/></Grid.ColumnDefinitions>
                    <Button x:Name="AsmodianFactionButton" Content="Asmodian" Margin="0,0,8,0" Padding="9,10"
                            Click="SelectAsmodian_Click" AutomationProperties.Name="Asmodian quests"/>
                    <Button x:Name="ElyosFactionButton" Grid.Column="1" Content="Elyos · Experimental" Padding="9,10"
                            Click="SelectElyos_Click" AutomationProperties.Name="Elyos quests, experimental"/>
                </Grid>
                <TextBlock x:Name="FactionStatus" TextWrapping="Wrap" Foreground="#94A3B8" Margin="0,10,0,0"/>
                <TextBlock x:Name="ElyosNotice" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#94A3B8" Margin="0,8,0,0"
                           Text="Elyos recognition is experimental. Route notes start empty; add your own in the quest library."/>
                <Separator Margin="0,20,0,0"/>
            </StackPanel>
            <DockPanel>
                <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Foreground="#93C5FD"/>
                <TextBlock Text="Background opacity"/>
            </DockPanel>
            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="1"
                    ValueChanged="AppearanceSlider_Changed" AutomationProperties.Name="Background opacity"/>
            <DockPanel>
                <TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Foreground="#93C5FD"/>
                <TextBlock Text="Overlay size"/>
            </DockPanel>
            <Slider x:Name="ScaleSlider" Minimum="80" Maximum="150" TickFrequency="5"
                    ValueChanged="AppearanceSlider_Changed" AutomationProperties.Name="Overlay size"/>
            <DockPanel>
                <TextBlock x:Name="WidthValue" DockPanel.Dock="Right" Foreground="#93C5FD"/>
                <TextBlock Text="Layout width"/>
            </DockPanel>
            <Slider x:Name="WidthSlider" Minimum="360" Maximum="720" TickFrequency="10"
                    ValueChanged="AppearanceSlider_Changed" AutomationProperties.Name="Layout width"/>
            <TextBlock Text="COLORS" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Background" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Tag="Background" Click="ChooseColor_Click" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BackgroundSwatch" Width="18" Height="18" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"/>
                        <TextBlock x:Name="BackgroundHex" Margin="9,0,0,0" FontFamily="Consolas"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Row="1" Text="Text" VerticalAlignment="Center"/>
                <Button Grid.Row="1" Grid.Column="1" Tag="Text" Click="ChooseColor_Click" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="TextSwatch" Width="18" Height="18" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"/>
                        <TextBlock x:Name="TextHex" Margin="9,0,0,0" FontFamily="Consolas"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Row="2" Text="Accent" VerticalAlignment="Center"/>
                <Button Grid.Row="2" Grid.Column="1" Tag="Accent" Click="ChooseColor_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="AccentSwatch" Width="18" Height="18" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"/>
                        <TextBlock x:Name="AccentHex" Margin="9,0,0,0" FontFamily="Consolas"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Separator Margin="0,20,0,14" Background="#334155"/>
            <Button x:Name="EditAllNotesButton" Content="Edit all quest notes" Click="EditAllNotes_Click"
                    AutomationProperties.Name="Edit all quest notes" HorizontalAlignment="Stretch"/>
            <TextBlock Text="Browse and edit any step without playing through the story."
                       TextWrapping="Wrap" Foreground="#94A3B8" Margin="0,8,0,0"/>
            <TextBlock x:Name="SaveStatus" Text="Changes are saved automatically."
                       Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,18,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="Restore appearance" HorizontalAlignment="Left" Click="RestoreDefaults_Click"/>
                <Button Grid.Column="1" Content="Done" Background="#285DA5" Click="Done_Click"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
    </Grid>
    </Border>
</Window>
